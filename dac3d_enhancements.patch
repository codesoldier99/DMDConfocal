index 0000000..db31ad2
--- /dev/null
+++ b/dac3d/core/pipeline/frame_buffer_pool.py
@@ -0,0 +1,135 @@
+"""
+帧缓冲区池
+
+借鉴 DMDConfocal 的缓冲区复用策略：
+- 预分配固定数量的缓冲区
+- 获取/归还模式避免运行时 malloc
+- 尺寸变化检测：仅在分辨率变化时重新分配
+"""
+
+import logging
+import threading
+from collections import deque
+from typing import Optional, Tuple
+import numpy as np
+from numpy.typing import NDArray
+
+
+logger = logging.getLogger(__name__)
+
+
+class FrameBufferPool:
+    """帧缓冲区池
+
+    预分配 N 个帧缓冲区循环复用，消除每帧的 numpy array 分配开销。
+    借鉴 DMDConfocal 的 if(m_imgsize != pHeader->Vsize) 尺寸检测策略。
+    """
+
+    def __init__(
+        self,
+        shape: Tuple[int, ...],
+        dtype: np.dtype = np.uint16,
+        pool_size: int = 8
+    ):
+        """初始化
+
+        Args:
+            shape: 帧尺寸 (height, width) 或 (height, width, channels)
+            dtype: 数据类型
+            pool_size: 预分配缓冲区数量
+        """
+        self._shape = shape
+        self._dtype = np.dtype(dtype)
+        self._pool_size = pool_size
+        self._lock = threading.Lock()
+
+        # 预分配缓冲区
+        self._available: deque = deque()
+        self._in_use: set = set()
+        self._total_allocated = 0
+
+        self._preallocate(pool_size)
+        logger.info(
+            f"FrameBufferPool: {pool_size} buffers, "
+            f"shape={shape}, dtype={dtype}, "
+            f"total={pool_size * np.prod(shape) * np.dtype(dtype).itemsize / 1024 / 1024:.1f} MB"
+        )
+
+    def _preallocate(self, count: int) -> None:
+        """预分配缓冲区"""
+        for _ in range(count):
+            buf = np.empty(self._shape, dtype=self._dtype)
+            self._available.append(buf)
+            self._total_allocated += 1
+
+    def acquire(self) -> NDArray:
+        """获取一个缓冲区（零分配，除非池耗尽）
+
+        Returns:
+            NDArray: 可复用的缓冲区
+        """
+        with self._lock:
+            if self._available:
+                buf = self._available.popleft()
+                self._in_use.add(id(buf))
+                return buf
+
+        # 池耗尽，动态分配（不在锁内）
+        logger.warning("FrameBufferPool: pool exhausted, allocating new buffer")
+        buf = np.empty(self._shape, dtype=self._dtype)
+        with self._lock:
+            self._in_use.add(id(buf))
+            self._total_allocated += 1
+        return buf
+
+    def release(self, buf: NDArray) -> None:
+        """归还缓冲区
+
+        Args:
+            buf: 之前通过 acquire() 获取的缓冲区
+        """
+        with self._lock:
+            buf_id = id(buf)
+            if buf_id in self._in_use:
+                self._in_use.discard(buf_id)
+                self._available.append(buf)
+            else:
+                logger.warning("FrameBufferPool: releasing unknown buffer")
+
+    def resize(self, new_shape: Tuple[int, ...], new_dtype: Optional[np.dtype] = None) -> None:
+        """重新分配缓冲区（尺寸变化时调用）
+
+        等价于 DMDConfocal 的尺寸变化检测逻辑。
+        """
+        dtype = np.dtype(new_dtype) if new_dtype else self._dtype
+        if new_shape == self._shape and dtype == self._dtype:
+            return  # 尺寸未变，跳过
+
+        logger.info(f"FrameBufferPool: resizing {self._shape} -> {new_shape}")
+        with self._lock:
+            self._shape = new_shape
+            self._dtype = dtype
+            self._available.clear()
+            self._in_use.clear()
+            self._total_allocated = 0
+
+        self._preallocate(self._pool_size)
+
+    @property
+    def shape(self) -> Tuple[int, ...]:
+        return self._shape
+
+    @property
+    def available_count(self) -> int:
+        return len(self._available)
+
+    @property
+    def in_use_count(self) -> int:
+        return len(self._in_use)
+
+    @property
+    def total_allocated(self) -> int:
+        return self._total_allocated
+
+
+__all__ = ["FrameBufferPool"]
diff --git a/dac3d/core/pipeline/render_chain.py b/dac3d/core/pipeline/render_chain.py
