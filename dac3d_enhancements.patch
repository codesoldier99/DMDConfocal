index 0000000..938edad
--- /dev/null
+++ b/dac3d/processing/confocal_merge.py
@@ -0,0 +1,125 @@
+"""
+流式共聚焦合并处理器
+
+借鉴 DMDConfocal 的 CConfocalMerge：
+- 流式处理：每帧到达立即与累积结果合并
+- 恒定内存：仅需 2 个缓冲区（结果 + 当前帧）
+- 事件驱动：使用队列确保不丢帧
+"""
+
+import logging
+import queue
+import threading
+from typing import Optional, Callable, Dict, Any
+import numpy as np
+from numpy.typing import NDArray
+
+from dac3d.core.pipeline.render_chain import FrameProcessor
+from dac3d.processing.image_ops import img_max
+
+
+logger = logging.getLogger(__name__)
+
+
+class ConfocalMergeProcessor(FrameProcessor):
+    """流式共聚焦合并器
+
+    等价于 DMDConfocal 的 CConfocalMerge。
+    每帧到达后立即与累积结果取最大值（最大值投影），
+    达到指定帧数后输出结果并重置。
+
+    内存占用恒定：O(2 × frame_size)，与总帧数无关。
+    """
+
+    def __init__(
+        self,
+        merge_count: int = 1,
+        background_thresh: int = 0,
+        on_complete: Optional[Callable[[NDArray], None]] = None,
+    ):
+        self._merge_count = merge_count
+        self._bg_thresh = background_thresh
+        self._on_complete = on_complete
+
+        # 缓冲区（等价于 m_bmpResult）
+        self._result: Optional[NDArray] = None
+        self._current_index = 0
+        self._imgsize = 0
+
+        # 使用队列确保不丢帧
+        self._frame_queue: queue.Queue = queue.Queue(maxsize=64)
+        self._running = True
+
+        # 处理线程（等价于 CreateThread(NULL, 0, ImageProc, ...)）
+        self._worker = threading.Thread(
+            target=self._process_loop, name="confocal-merge", daemon=True
+        )
+        self._worker.start()
+
+        logger.info(f"ConfocalMergeProcessor: merge_count={merge_count}, thresh={background_thresh}")
+
+    def process(self, frame: NDArray, metadata: Dict[str, Any]) -> None:
+        """接收帧数据（从采集线程调用）
+
+        等价于 DMDConfocal CConfocalMerge::Renderer()
+        """
+        # 拷贝帧数据入队（等价于 memcpy + SetEvent）
+        self._frame_queue.put(frame.copy())
+
+    def _process_loop(self):
+        """处理线程主循环
+
+        等价于 DMDConfocal CConfocalMerge::ProcessImage()
+        """
+        while self._running:
+            try:
+                frame = self._frame_queue.get(timeout=0.5)
+            except queue.Empty:
+                continue
+
+            # 尺寸变化检测
+            frame_size = frame.nbytes
+            if self._imgsize != frame_size:
+                self._imgsize = frame_size
+                self._result = np.zeros_like(frame)
+
+            # 最大值投影（等价于 Img8_Max(m_bmpResult, m_bmpTemp, ...)）
+            img_max(self._result, frame, self._bg_thresh)
+            self._current_index += 1
+
+            if self._current_index >= self._merge_count:
+                # 合并完成，输出结果
+                if self._on_complete:
+                    self._on_complete(self._result.copy())
+                self._reset()
+
+    def _reset(self):
+        """重置合并状态（等价于 RestMerge）"""
+        if self._result is not None:
+            self._result.fill(0)
+        self._current_index = 0
+
+    def reset(self):
+        """外部调用的重置接口"""
+        self._reset()
+
+    @property
+    def current_index(self) -> int:
+        return self._current_index
+
+    @property
+    def merge_count(self) -> int:
+        return self._merge_count
+
+    @merge_count.setter
+    def merge_count(self, value: int):
+        self._merge_count = value
+
+    def shutdown(self):
+        """关闭处理器"""
+        self._running = False
+        self._worker.join(timeout=2.0)
+        logger.info("ConfocalMergeProcessor: shutdown")
+
+
+__all__ = ["ConfocalMergeProcessor"]
diff --git a/dac3d/processing/image_ops.py b/dac3d/processing/image_ops.py
new file mode 100644
index 0000000..37ee98a
--- /dev/null
+++ b/dac3d/processing/image_ops.py
@@ -0,0 +1,193 @@
+"""
+NumPy 向量化图像处理算法
+
+移植自 DMDConfocal 的 HImgProcess.cpp，使用 NumPy 向量化替代 C++ 指针循环。
+核心原则：
+- 就地操作 (out= 参数) 避免临时数组分配
+- 一维化处理自动通过 NumPy broadcasting 实现
+- 分支外提通过条件分发实现
+"""
+
+import numpy as np
+from numpy.typing import NDArray
+
+
+def img_max(
+    dest: NDArray[np.uint8],
+    src: NDArray[np.uint8],
+    thresh: int = 0
+) -> None:
+    """逐像素最大值投影（就地操作）
+
+    等价于 DMDConfocal 的 Img8_Max()。
+    模拟共聚焦针孔效应，每帧到达后与累积结果取最大值。
+
+    Args:
+        dest: 目标缓冲区（就地修改）
+        src: 源帧数据
+        thresh: 背景阈值（减除后再比较）
+    """
+    if thresh > 0:
+        # 带阈值减除：等价于 C++ 的 iScr = *Index_Scr - Thresh; iScr = iScr > 0 ? iScr : 0;
+        src_adj = np.clip(src.astype(np.int16) - thresh, 0, 255).astype(np.uint8)
+        np.maximum(dest, src_adj, out=dest)
+    else:
+        # 无阈值：直接取最大值
+        np.maximum(dest, src, out=dest)
+
+
+def img_add(
+    dest: NDArray[np.uint8],
+    src: NDArray[np.uint8],
+) -> None:
+    """逐像素取最大值累加（等价于 DMDConfocal Img8_Add）
+
+    Args:
+        dest: 目标缓冲区（就地修改）
+        src: 源帧数据
+    """
+    np.maximum(dest, src, out=dest)
+
+
+def img_and(
+    dest: NDArray[np.uint8],
+    template: NDArray[np.uint8],
+) -> None:
+    """模板掩膜与操作（等价于 DMDConfocal Img8_And）
+
+    模板为 0 的位置，目标也设为 0。
+
+    Args:
+        dest: 目标缓冲区（就地修改）
+        template: 二值模板
+    """
+    dest[template == 0] = 0
+
+
+def img_thresh(
+    buf: NDArray[np.uint8],
+    thresh: int
+) -> None:
+    """二值阈值化（就地操作，等价于 DMDConfocal Img8_Thresh2）
+
+    Args:
+        buf: 图像缓冲区（就地修改）
+        thresh: 阈值
+    """
+    mask = buf <= thresh
+    buf[mask] = 0
+    buf[~mask] = 255
+
+
+def reconstruct_3phase(
+    imgs: list,
+    merge: NDArray[np.uint8],
+) -> None:
+    """3 帧相移重建（等价于 DMDConfocal ReconstructImage, 3-frame mode）
+
+    公式: I = sqrt((2*I2 - I1 - I3)^2 + (I3 - I1)^2) / 2
+
+    Args:
+        imgs: 3 帧灰度图列表 [I1, I2, I3]
+        merge: 输出缓冲区（就地写入）
+    """
+    # 预提取为 float64 数组（等价于 C++ 的 unsigned char* a0 = imgs[0].data()）
+    a = imgs[0].astype(np.float64)
+    b = imgs[1].astype(np.float64)
+    c = imgs[2].astype(np.float64)
+
+    s = 2.0 * b - a - c
+    t = c - a
+    # 复用 s 的内存存放结果
+    np.multiply(s, s, out=s)
+    np.multiply(t, t, out=t)
+    s += t
+    np.sqrt(s, out=s)
+    s *= 0.5
+    np.clip(s, 0, 255, out=s)
+    merge[:] = s.astype(np.uint8)
+
+
+def reconstruct_6phase(
+    imgs: list,
+    merge: NDArray[np.uint8],
+) -> None:
+    """6 帧双波长重建（等价于 DMDConfocal ReconstructImage, 6-frame mode）
+
+    两组 3 帧重建取平均，提高信噪比。
+
+    Args:
+        imgs: 6 帧灰度图列表 [I1, I2, I3, I4, I5, I6]
+        merge: 输出缓冲区（就地写入）
+    """
+    # 第一组
+    a0 = imgs[0].astype(np.float64)
+    b0 = imgs[1].astype(np.float64)
+    c0 = imgs[2].astype(np.float64)
+    s0 = 2.0 * b0 - a0 - c0
+    t0 = c0 - a0
+    res0 = np.sqrt(s0 * s0 + t0 * t0) * 0.5
+
+    # 第二组
+    a1 = imgs[3].astype(np.float64)
+    b1 = imgs[4].astype(np.float64)
+    c1 = imgs[5].astype(np.float64)
+    s1 = 2.0 * b1 - a1 - c1
+    t1 = c1 - a1
+    res1 = np.sqrt(s1 * s1 + t1 * t1) * 0.5
+
+    # 取平均
+    result = (res0 + res1) * 0.5
+    np.clip(result, 0, 255, out=result)
+    merge[:] = result.astype(np.uint8)
+
+
+def is_dark_image(img: NDArray, threshold: float = 3.0) -> bool:
+    """暗图检测（等价于 DMDConfocal IsDarkImage）
+
+    通过方差统计判断图像是否为暗图（如 DMD 全黑帧），
+    单遍遍历完成均值和标准差计算。
+
+    Args:
+        img: 输入图像
+        threshold: 标准差阈值
+
+    Returns:
+        bool: True 表示是暗图
+    """
+    if img.size == 0:
+        return False
+    return float(np.std(img)) < threshold
+
+
+def rgb_to_gray(img: NDArray[np.uint8]) -> NDArray[np.uint8]:
+    """RGB 转灰度（等价于 DMDConfocal RGB2Gray）
+
+    使用 ITU-R BT.601 权重: 0.299R + 0.587G + 0.114B
+
+    Args:
+        img: RGB 图像 (H, W, 3)
+
+    Returns:
+        灰度图 (H, W)
+    """
+    if img.ndim == 2:
+        return img
+    # 使用整数乘法避免浮点开销（等价于 C++ 的 299/587/114 整数运算）
+    r = img[:, :, 0].astype(np.int32)
+    g = img[:, :, 1].astype(np.int32)
+    b = img[:, :, 2].astype(np.int32)
+    gray = (299 * r + 587 * g + 114 * b) // 1000
+    return gray.astype(np.uint8)
+
+
+__all__ = [
+    "img_max",
+    "img_add",
+    "img_and",
+    "img_thresh",
+    "reconstruct_3phase",
+    "reconstruct_6phase",
+    "is_dark_image",
+    "rgb_to_gray",
+]
diff --git a/dac3d/processing/struct_light.py b/dac3d/processing/struct_light.py
new file mode 100644
index 0000000..a349056
--- /dev/null
+++ b/dac3d/processing/struct_light.py
@@ -0,0 +1,154 @@
+"""
+结构光重建处理器
+
+借鉴 DMDConfocal 的 StructLightReconstruct：
+- 3帧/6帧相移重建
+- 暗图自动检测和跳过
+- 事件驱动处理线程
+"""
+
+import logging
+import threading
+from typing import Optional, Callable, List, Dict, Any
+import numpy as np
+from numpy.typing import NDArray
+
+from dac3d.core.pipeline.render_chain import FrameProcessor
+from dac3d.processing.image_ops import reconstruct_3phase, reconstruct_6phase, is_dark_image
+
+
+logger = logging.getLogger(__name__)
+
+
+class StructuredLightProcessor(FrameProcessor):
+    """结构光重建处理器
+
+    等价于 DMDConfocal 的 StructLightReconstruct。
+    收集指定帧数的相移图像后执行重建。
+    """
+
+    def __init__(
+        self,
+        merge_count: int = 3,
+        dark_threshold: float = 3.0,
+        on_complete: Optional[Callable[[NDArray], None]] = None,
+    ):
+        """初始化
+
+        Args:
+            merge_count: 合并帧数（3 或 6）
+            dark_threshold: 暗图检测方差阈值
+            on_complete: 重建完成回调
+        """
+        if merge_count not in (3, 6):
+            raise ValueError("merge_count must be 3 or 6")
+
+        self._merge_count = merge_count
+        self._dark_threshold = dark_threshold
+        self._on_complete = on_complete
+
+        # 帧收集（等价于 _imgs vector）
+        self._imgs: List[NDArray] = []
+        self._result: Optional[NDArray] = None
+        self._imgsize = 0
+        self._has_dark_img = False
+
+        # 事件驱动
+        self._event = threading.Event()
+        self._running = True
+        self._temp_frame: Optional[NDArray] = None
+        self._lock = threading.Lock()
+        self._current_index = 0
+
+        self._worker = threading.Thread(
+            target=self._process_loop, name="struct-light", daemon=True
+        )
+        self._worker.start()
+
+        logger.info(f"StructuredLightProcessor: merge_count={merge_count}")
+
+    def process(self, frame: NDArray, metadata: Dict[str, Any]) -> None:
+        """接收帧数据
+
+        等价于 DMDConfocal StructLightReconstruct::Renderer()
+        """
+        frame_size = frame.nbytes
+
+        # 尺寸变化检测
+        if self._imgsize != frame_size:
+            self._imgsize = frame_size
+            with self._lock:
+                self._result = np.zeros_like(frame)
+                self._temp_frame = np.empty_like(frame)
+
+        with self._lock:
+            if self._temp_frame is not None:
+                np.copyto(self._temp_frame, frame)
+
+        self._event.set()
+
+    def _process_loop(self):
+        """处理线程主循环"""
+        while self._running:
+            self._event.wait()
+            self._event.clear()
+
+            if not self._running:
+                break
+
+            with self._lock:
+                if self._temp_frame is None:
+                    continue
+                temp = self._temp_frame.copy()
+
+            # 暗图检测（等价于 DMDConfocal 的 IsDarkImage 前置检查）
+            if not self._has_dark_img:
+                if is_dark_image(temp, self._dark_threshold):
+                    self._current_index = 0
+                    self._has_dark_img = True
+                continue
+
+            # 收集帧
+            self._imgs.append(temp)
+            self._current_index += 1
+
+            if self._current_index >= self._merge_count:
+                # 执行重建
+                with self._lock:
+                    if self._result is None:
+                        self._result = np.zeros_like(temp)
+
+                if self._merge_count == 3:
+                    reconstruct_3phase(self._imgs, self._result)
+                else:
+                    reconstruct_6phase(self._imgs, self._result)
+
+                if self._on_complete:
+                    self._on_complete(self._result.copy())
+
+                self._reset()
+
+    def _reset(self):
+        """重置状态"""
+        with self._lock:
+            if self._result is not None:
+                self._result.fill(0)
+        self._imgs.clear()
+        self._current_index = 0
+        self._has_dark_img = False
+
+    def reset(self):
+        self._reset()
+
+    @property
+    def current_index(self) -> int:
+        return self._current_index
+
+    def shutdown(self):
+        self._running = False
+        self._event.set()
+        self._worker.join(timeout=2.0)
+        logger.info("StructuredLightProcessor: shutdown")
+
+
+__all__ = ["StructuredLightProcessor"]
