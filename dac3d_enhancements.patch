@@ -0,0 +1,157 @@
+"""
+异步帧保存器
+
+借鉴 DMDConfocal 的异步保存策略：
+- memcpy 到专用缓冲区后立即启动保存线程
+- 处理线程不等待 I/O 完成
+- 支持多种格式（npy, tiff, bmp）
+"""
+
+import logging
+import queue
+import threading
+from pathlib import Path
+from typing import Optional
+import numpy as np
+from numpy.typing import NDArray
+
+
+logger = logging.getLogger(__name__)
+
+
+class AsyncFrameSaver:
+    """异步帧保存器
+
+    将保存操作从处理流水线中解耦，保存在独立线程中完成。
+    等价于 DMDConfocal 的 SaveProc 线程 + m_SaveTemp 专用缓冲区。
+    """
+
+    def __init__(self, max_pending: int = 32, n_workers: int = 2):
+        """初始化
+
+        Args:
+            max_pending: 最大挂起保存任务数
+            n_workers: 保存工作线程数
+        """
+        self._queue: queue.Queue = queue.Queue(maxsize=max_pending)
+        self._running = True
+        self._workers = []
+        self._save_count = 0
+        self._error_count = 0
+        self._lock = threading.Lock()
+
+        for i in range(n_workers):
+            t = threading.Thread(target=self._save_worker, name=f"saver-{i}", daemon=True)
+            t.start()
+            self._workers.append(t)
+
+        logger.info(f"AsyncFrameSaver: {n_workers} workers, max_pending={max_pending}")
+
+    def save(self, frame: NDArray, path: str, fmt: str = "npy") -> bool:
+        """非阻塞提交保存任务
+
+        先拷贝到专用缓冲区，调用者可立即复用原帧缓冲区。
+
+        Args:
+            frame: 图像数据
+            path: 保存路径
+            fmt: 格式 ("npy", "raw")
+
+        Returns:
+            bool: 成功加入队列返回 True
+        """
+        # 拷贝到专用缓冲区（等价于 DMDConfocal 的 memcpy(m_SaveTemp, ...)）
+        frame_copy = frame.copy()
+
+        try:
+            self._queue.put_nowait((frame_copy, path, fmt))
+            return True
+        except queue.Full:
+            logger.warning("AsyncFrameSaver: queue full, dropping frame")
+            return False
+
+    def _save_worker(self):
+        """保存工作线程"""
+        while self._running:
+            try:
+                item = self._queue.get(timeout=0.5)
+            except queue.Empty:
+                continue
+
+            frame, path, fmt = item
+            try:
+                p = Path(path)
+                p.parent.mkdir(parents=True, exist_ok=True)
+
+                if fmt == "npy":
+                    np.save(str(p), frame)
+                elif fmt == "raw":
+                    frame.tofile(str(p))
+                else:
+                    np.save(str(p), frame)
+
+                with self._lock:
+                    self._save_count += 1
+
+                logger.debug(f"AsyncFrameSaver: saved {p.name}")
+            except Exception as e:
+                with self._lock:
+                    self._error_count += 1
+                logger.error(f"AsyncFrameSaver: save error: {e}")
+            finally:
+                self._queue.task_done()
+
+    def flush(self, timeout: Optional[float] = None) -> bool:
+        """等待所有挂起的保存完成
+
+        Args:
+            timeout: 超时时间（秒），None 表示无限等待
+
+        Returns:
+            bool: 队列是否已清空
+        """
+        try:
+            self._queue.all_tasks_done.acquire()
+            try:
+                endtime = None
+                if timeout is not None:
+                    import time
+                    endtime = time.monotonic() + timeout
+                while self._queue.unfinished_tasks:
+                    if endtime is not None:
+                        remaining = endtime - __import__('time').monotonic()
+                        if remaining <= 0:
+                            return False
+                        self._queue.all_tasks_done.wait(remaining)
+                    else:
+                        self._queue.all_tasks_done.wait()
+            finally:
+                self._queue.all_tasks_done.release()
+            return True
+        except Exception:
+            return False
+
+    def shutdown(self) -> None:
+        """关闭保存器"""
+        self._running = False
+        for t in self._workers:
+            t.join(timeout=2.0)
+        logger.info(
+            f"AsyncFrameSaver: shutdown, "
+            f"saved={self._save_count}, errors={self._error_count}"
+        )
+
+    @property
+    def pending_count(self) -> int:
+        return self._queue.qsize()
+
+    @property
+    def save_count(self) -> int:
+        return self._save_count
+
+    @property
+    def error_count(self) -> int:
+        return self._error_count
+
+
+__all__ = ["AsyncFrameSaver"]
diff --git a/dac3d/core/pipeline/frame_buffer_pool.py b/dac3d/core/pipeline/frame_buffer_pool.py
