@@ -0,0 +1,123 @@
+"""
+渲染链（流式处理管线）
+
+借鉴 DMDConfocal 的 HVideoRenderChain 设计：
+- 责任链模式：帧数据依次流过处理链
+- 运行时热插拔：动态添加/移除处理器
+- 零拷贝传递：所有处理器共享同一帧引用
+"""
+
+import logging
+import threading
+from abc import ABC, abstractmethod
+from typing import List, Dict, Any, Optional
+import numpy as np
+from numpy.typing import NDArray
+
+
+logger = logging.getLogger(__name__)
+
+
+class FrameProcessor(ABC):
+    """帧处理器基类，等价于 DMDConfocal 的 HVideoRender"""
+
+    @abstractmethod
+    def process(self, frame: NDArray, metadata: Dict[str, Any]) -> None:
+        """处理一帧数据
+
+        Args:
+            frame: 图像数据（共享引用，勿修改原数据除非就地操作）
+            metadata: 帧元数据 (camera_id, index, timestamp 等)
+        """
+        pass
+
+
+class RenderChain(FrameProcessor):
+    """渲染链，等价于 DMDConfocal 的 HVideoRenderChain
+
+    同时是处理器和处理器容器（Composite 模式），
+    支持运行时热插拔处理器。
+    """
+
+    def __init__(self, name: str = "default"):
+        self._name = name
+        self._processors: List[FrameProcessor] = []
+        self._lock = threading.Lock()
+        logger.info(f"RenderChain '{name}' created")
+
+    @property
+    def name(self) -> str:
+        return self._name
+
+    def add(self, processor: FrameProcessor) -> None:
+        """添加处理器到链尾（等价于 push_back）"""
+        with self._lock:
+            if processor not in self._processors:
+                self._processors.append(processor)
+                logger.debug(f"RenderChain '{self._name}': added {type(processor).__name__}")
+
+    def remove(self, processor: FrameProcessor) -> None:
+        """移除处理器（等价于 remove）"""
+        with self._lock:
+            if processor in self._processors:
+                self._processors.remove(processor)
+                logger.debug(f"RenderChain '{self._name}': removed {type(processor).__name__}")
+
+    def clear(self) -> None:
+        """清空处理链"""
+        with self._lock:
+            self._processors.clear()
+
+    def process(self, frame: NDArray, metadata: Dict[str, Any]) -> None:
+        """将帧依次送入链中每个处理器"""
+        with self._lock:
+            processors = list(self._processors)  # snapshot
+
+        for proc in processors:
+            try:
+                proc.process(frame, metadata)
+            except Exception as e:
+                logger.error(
+                    f"RenderChain '{self._name}': "
+                    f"{type(proc).__name__} error: {e}"
+                )
+
+    def __len__(self) -> int:
+        return len(self._processors)
+
+    def __contains__(self, processor: FrameProcessor) -> bool:
+        return processor in self._processors
+
+
+class RenderChainManager:
+    """渲染链管理器，管理多条命名渲染链
+
+    等价于 DMDConfocal 的 HConfocalCore::GetRenderChain(RenderChainType)
+    """
+
+    NORMAL = "normal"
+    CONFOCAL = "confocal"
+    STRUCTURED_LIGHT = "structured_light"
+    NORMAL_EX = "normal_ex"
+    CONFOCAL_EX = "confocal_ex"
+
+    def __init__(self):
+        self._chains: Dict[str, RenderChain] = {
+            self.NORMAL: RenderChain(self.NORMAL),
+            self.CONFOCAL: RenderChain(self.CONFOCAL),
+            self.STRUCTURED_LIGHT: RenderChain(self.STRUCTURED_LIGHT),
+            self.NORMAL_EX: RenderChain(self.NORMAL_EX),
+            self.CONFOCAL_EX: RenderChain(self.CONFOCAL_EX),
+        }
+
+    def get_chain(self, name: str = NORMAL) -> RenderChain:
+        """获取指定渲染链"""
+        if name not in self._chains:
+            self._chains[name] = RenderChain(name)
+        return self._chains[name]
+
+    def get_all_chains(self) -> Dict[str, RenderChain]:
+        return dict(self._chains)
+
+
+__all__ = ["FrameProcessor", "RenderChain", "RenderChainManager"]
