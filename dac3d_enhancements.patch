+# ============================================================
+# 6. 流式共聚焦合并测试
+# ============================================================
+
+from dac3d.processing.confocal_merge import ConfocalMergeProcessor
+
+
+class TestConfocalMerge:
+
+    def test_merge_completes_after_n_frames(self):
+        results = []
+
+        def on_complete(result):
+            results.append(result.copy())
+
+        merger = ConfocalMergeProcessor(
+            merge_count=3,
+            background_thresh=0,
+            on_complete=on_complete,
+        )
+
+        # 发送 3 帧
+        for i in range(3):
+            frame = np.full((32, 32), (i + 1) * 50, dtype=np.uint8)
+            merger.process(frame, {"index": i})
+
+        # 等待处理完成
+        time.sleep(0.5)
+
+        assert len(results) == 1
+        # 最大值投影: max(50, 100, 150) = 150
+        assert results[0][0, 0] == 150
+
+        merger.shutdown()
+
+    def test_merge_resets_after_complete(self):
+        results = []
+
+        merger = ConfocalMergeProcessor(
+            merge_count=2,
+            on_complete=lambda r: results.append(r.copy()),
+        )
+
+        # 第一轮
+        merger.process(np.full((16, 16), 100, dtype=np.uint8), {})
+        merger.process(np.full((16, 16), 200, dtype=np.uint8), {})
+        time.sleep(0.3)
+
+        # 第二轮
+        merger.process(np.full((16, 16), 50, dtype=np.uint8), {})
+        merger.process(np.full((16, 16), 80, dtype=np.uint8), {})
+        time.sleep(0.3)
+
+        assert len(results) == 2
+        assert results[0][0, 0] == 200  # max(100, 200)
+        assert results[1][0, 0] == 80   # max(50, 80), 重置后的新一轮
+
+        merger.shutdown()
+
+    def test_merge_with_threshold(self):
+        results = []
+
+        merger = ConfocalMergeProcessor(
+            merge_count=2,
+            background_thresh=30,
+            on_complete=lambda r: results.append(r.copy()),
+        )
+
+        merger.process(np.full((8, 8), 50, dtype=np.uint8), {})
+        merger.process(np.full((8, 8), 20, dtype=np.uint8), {})
+        time.sleep(0.3)
+
+        assert len(results) == 1
+        # thresh=30: 50-30=20, 20-30=0 → max = 20
+        assert results[0][0, 0] == 20
+
+        merger.shutdown()
+
+    def test_constant_memory(self):
