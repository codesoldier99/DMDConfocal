+"""
+DMDConfocal 八大增强模块的综合测试
+
+覆盖：
+1. RenderChain 流式管线
+2. 事件驱动同步
+3. 帧缓冲区池
+4. 异步文件保存
+5. NumPy 向量化图像处理
+6. 流式共聚焦合并
+7. 结构光重建
+8. DMD 模拟驱动
+"""
+
+import os
+import time
+import tempfile
+import threading
+import pytest
+import numpy as np
+
+# ============================================================
+# 1. RenderChain 流式管线测试
+# ============================================================
+
+from dac3d.core.pipeline.render_chain import (
+    FrameProcessor, RenderChain, RenderChainManager,
+)
+
+
+class CountingProcessor(FrameProcessor):
+    """计数处理器（测试用）"""
+    def __init__(self):
+        self.count = 0
+        self.last_frame = None
+        self.last_metadata = None
+
+    def process(self, frame, metadata):
+        self.count += 1
+        self.last_frame = frame
+        self.last_metadata = metadata
+
+
+class AccumulatingProcessor(FrameProcessor):
+    """累积处理器（测试就地修改）"""
+    def __init__(self):
+        self.total = 0
+
+    def process(self, frame, metadata):
+        self.total += frame.sum()
+
+
+class TestRenderChain:
+    """测试渲染链"""
+
+    def test_add_and_remove(self):
+        chain = RenderChain("test")
+        p1 = CountingProcessor()
+        p2 = CountingProcessor()
+
+        chain.add(p1)
+        chain.add(p2)
+        assert len(chain) == 2
+
+        chain.remove(p1)
+        assert len(chain) == 1
+        assert p1 not in chain
+        assert p2 in chain
+
+    def test_no_duplicate_add(self):
+        chain = RenderChain("test")
+        p = CountingProcessor()
+        chain.add(p)
+        chain.add(p)  # 重复添加
+        assert len(chain) == 1
+
+    def test_process_chain(self):
+        chain = RenderChain("test")
+        p1 = CountingProcessor()
+        p2 = CountingProcessor()
+        chain.add(p1)
+        chain.add(p2)
+
+        frame = np.zeros((64, 64), dtype=np.uint8)
+        chain.process(frame, {"index": 0})
+
+        assert p1.count == 1
+        assert p2.count == 1
+        assert p1.last_metadata == {"index": 0}
+
+    def test_process_order(self):
+        """确保处理器按添加顺序执行"""
+        chain = RenderChain("test")
+        order = []
+
+        class OrderedProc(FrameProcessor):
+            def __init__(self, name):
+                self._name = name
+            def process(self, frame, metadata):
+                order.append(self._name)
+
+        chain.add(OrderedProc("A"))
+        chain.add(OrderedProc("B"))
+        chain.add(OrderedProc("C"))
+
+        chain.process(np.zeros(1), {})
+        assert order == ["A", "B", "C"]
+
+    def test_zero_copy_sharing(self):
+        """确保链中的处理器共享同一帧引用"""
+        chain = RenderChain("test")
+        p1 = CountingProcessor()
+        p2 = CountingProcessor()
+        chain.add(p1)
+        chain.add(p2)
+
+        frame = np.zeros((64, 64), dtype=np.uint8)
+        chain.process(frame, {})
+
+        # 两个处理器应该收到完全相同的对象引用
+        assert p1.last_frame is p2.last_frame
+
+    def test_hot_plug_during_processing(self):
+        """测试运行时热插拔"""
+        chain = RenderChain("test")
+        p1 = CountingProcessor()
+        chain.add(p1)
+
+        frame = np.zeros((64, 64), dtype=np.uint8)
+        chain.process(frame, {})
+        assert p1.count == 1
+
+        # 动态移除
+        chain.remove(p1)
+        chain.process(frame, {})
+        assert p1.count == 1  # 不再增长
+
+        # 动态添加
+        p2 = CountingProcessor()
+        chain.add(p2)
+        chain.process(frame, {})
+        assert p2.count == 1
+
+    def test_error_isolation(self):
+        """一个处理器异常不影响其他处理器"""
+        chain = RenderChain("test")
+
+        class FailingProc(FrameProcessor):
+            def process(self, frame, metadata):
+                raise RuntimeError("boom")
+
+        p1 = CountingProcessor()
+        fail = FailingProc()
+        p2 = CountingProcessor()
+
+        chain.add(p1)
+        chain.add(fail)
+        chain.add(p2)
+
+        chain.process(np.zeros(1), {})
+        assert p1.count == 1
+        assert p2.count == 1  # 不受异常影响
+
+
+class TestRenderChainManager:
+    def test_predefined_chains(self):
+        mgr = RenderChainManager()
+        assert mgr.get_chain("normal").name == "normal"
+        assert mgr.get_chain("confocal").name == "confocal"
+        assert mgr.get_chain("structured_light").name == "structured_light"
+
+    def test_custom_chain(self):
+        mgr = RenderChainManager()
+        chain = mgr.get_chain("custom")
+        assert chain.name == "custom"
+        assert mgr.get_chain("custom") is chain  # 同一实例
+
+
+# ============================================================
+# 2. 事件驱动同步测试
+# ============================================================
+
+from dac3d.hal.sim.sim_stage import SimStage
+from dac3d.hal.interfaces import Position
+
+
+class TestEventDrivenSync:
+    """测试事件驱动替代轮询"""
+
+    def test_wait_for_move_completes(self):
+        stage = SimStage("test", {"velocity": 1000.0})
+        stage.connect()
+        stage.home()
+
+        # 非阻塞移动
+        stage.move_to(Position(10, 0, 0), wait=False, velocity=1000.0)
+
+        # 事件驱动等待（替代 while is_moving: sleep）
+        result = stage.wait_for_move(timeout=5.0)
+        assert result is True
+        assert not stage.is_moving
+
+        pos = stage.get_position()
+        assert abs(pos.x - 10.0) < 0.1
+
+    def test_wait_for_move_timeout(self):
+        stage = SimStage("test", {"velocity": 0.001})  # 极慢速度
+        stage.connect()
+        stage.home()
+
+        stage.move_to(Position(1000, 0, 0), wait=False, velocity=0.001)
+
+        # 应该超时
+        result = stage.wait_for_move(timeout=0.05)
+        assert result is False
+
+        stage.stop()
+
+    def test_wait_for_move_already_complete(self):
+        stage = SimStage("test", {"velocity": 1000.0})
+        stage.connect()
+        stage.home()
+
+        # 阻塞移动（已完成）
+        stage.move_to(Position(1, 0, 0), wait=True, velocity=1000.0)
+
+        # 再次等待应该立即返回
+        result = stage.wait_for_move(timeout=0.01)
+        assert result is True
+
+    def test_event_driven_vs_polling_latency(self):
+        """验证事件驱动比轮询延迟更低"""
+        stage = SimStage("test", {"velocity": 10000.0})
+        stage.connect()
+        stage.home()
+
+        # 事件驱动方式
+        stage.move_to(Position(0.01, 0, 0), wait=False, velocity=10000.0)
+        t0 = time.time()
+        stage.wait_for_move(timeout=5.0)
+        event_time = time.time() - t0
+
+        # 轮询方式
+        stage.move_to(Position(0.02, 0, 0), wait=False, velocity=10000.0)
+        t0 = time.time()
+        while stage.is_moving:
+            time.sleep(0.01)
+        poll_time = time.time() - t0
+
+        # 事件驱动应该不会比轮询慢很多
+        # (不严格断言，仅验证两者都能完成)
+        assert event_time < 5.0
+        assert poll_time < 5.0
+
+
+# ============================================================
+# 3. 帧缓冲区池测试
+# ============================================================
+
+from dac3d.core.pipeline.frame_buffer_pool import FrameBufferPool
+
+
+class TestFrameBufferPool:
+
+    def test_basic_acquire_release(self):
+        pool = FrameBufferPool((64, 64), np.uint16, pool_size=4)
+        assert pool.available_count == 4
+        assert pool.in_use_count == 0
+
+        buf = pool.acquire()
+        assert buf.shape == (64, 64)
+        assert buf.dtype == np.uint16
+        assert pool.available_count == 3
+        assert pool.in_use_count == 1
+
+        pool.release(buf)
+        assert pool.available_count == 4
+        assert pool.in_use_count == 0
+
+    def test_zero_allocation_reuse(self):
+        """验证缓冲区复用：归还后再获取不增加总分配数"""
+        pool = FrameBufferPool((64, 64), np.uint8, pool_size=2)
+        assert pool.total_allocated == 2
+
+        buf1 = pool.acquire()
+        pool.release(buf1)
+
+        buf2 = pool.acquire()
+        # 总分配数不应增加（复用了已有缓冲区）
+        assert pool.total_allocated == 2
+        assert buf2.shape == (64, 64)
+        pool.release(buf2)
+
+    def test_pool_exhaustion_allocates_new(self):
+        pool = FrameBufferPool((32, 32), np.uint8, pool_size=2)
+
+        b1 = pool.acquire()
+        b2 = pool.acquire()
+        assert pool.available_count == 0
+
+        # 池耗尽，应该分配新缓冲区
+        b3 = pool.acquire()
+        assert b3.shape == (32, 32)
+        assert pool.total_allocated == 3
+
+        pool.release(b1)
+        pool.release(b2)
+        pool.release(b3)
+
+    def test_resize_reallocates(self):
+        pool = FrameBufferPool((64, 64), np.uint8, pool_size=4)
+        pool.resize((128, 128))
+        assert pool.shape == (128, 128)
+        assert pool.available_count == 4
+
+        buf = pool.acquire()
+        assert buf.shape == (128, 128)
+
+    def test_resize_same_size_noop(self):
+        pool = FrameBufferPool((64, 64), np.uint8, pool_size=4)
+        buf = pool.acquire()
+        original_id = id(buf)
+        pool.release(buf)
+
+        pool.resize((64, 64))  # 同尺寸不应触发重新分配
+        # 注意: resize 内部会检查，相同尺寸不操作
+        assert pool.shape == (64, 64)
+
+    def test_concurrent_access(self):
+        """多线程并发获取/释放"""
+        pool = FrameBufferPool((32, 32), np.uint8, pool_size=8)
+        errors = []
+
+        def worker():
+            try:
+                for _ in range(50):
+                    buf = pool.acquire()
+                    np.copyto(buf, np.random.randint(0, 255, (32, 32), dtype=np.uint8))
+                    time.sleep(0.001)
+                    pool.release(buf)
+            except Exception as e:
+                errors.append(e)
+
+        threads = [threading.Thread(target=worker) for _ in range(4)]
+        for t in threads:
+            t.start()
+        for t in threads:
+            t.join()
+
+        assert len(errors) == 0
+
+
+# ============================================================
+# 4. 异步文件保存测试
+# ============================================================
+
+from dac3d.core.pipeline.async_saver import AsyncFrameSaver
+
+
+class TestAsyncFrameSaver:
+
+    def test_save_npy(self):
+        with tempfile.TemporaryDirectory() as tmpdir:
+            saver = AsyncFrameSaver(max_pending=16, n_workers=1)
+
+            frame = np.random.randint(0, 255, (64, 64), dtype=np.uint8)
+            path = os.path.join(tmpdir, "test_frame.npy")
+            saver.save(frame, path, fmt="npy")
+
+            saver.flush(timeout=5.0)
+            saver.shutdown()
+
+            loaded = np.load(path)
+            np.testing.assert_array_equal(loaded, frame)
+
+    def test_save_raw(self):
+        with tempfile.TemporaryDirectory() as tmpdir:
+            saver = AsyncFrameSaver(max_pending=16, n_workers=1)
+
+            frame = np.random.randint(0, 4095, (32, 32), dtype=np.uint16)
+            path = os.path.join(tmpdir, "test_frame.raw")
+            saver.save(frame, path, fmt="raw")
+
+            saver.flush(timeout=5.0)
+            saver.shutdown()
+
+            loaded = np.fromfile(path, dtype=np.uint16).reshape(32, 32)
+            np.testing.assert_array_equal(loaded, frame)
+
+    def test_save_multiple_frames(self):
+        with tempfile.TemporaryDirectory() as tmpdir:
+            saver = AsyncFrameSaver(max_pending=32, n_workers=2)
+
+            n_frames = 20
+            for i in range(n_frames):
+                frame = np.full((16, 16), i, dtype=np.uint8)
+                path = os.path.join(tmpdir, f"frame_{i:03d}.npy")
+                saver.save(frame, path)
+
+            saver.flush(timeout=10.0)
+            assert saver.save_count == n_frames
+            assert saver.error_count == 0
+            saver.shutdown()
+
+            # 验证所有文件
+            for i in range(n_frames):
+                loaded = np.load(os.path.join(tmpdir, f"frame_{i:03d}.npy"))
+                assert loaded[0, 0] == i
+
+    def test_nonblocking(self):
+        """验证 save() 不阻塞调用者"""
+        with tempfile.TemporaryDirectory() as tmpdir:
+            saver = AsyncFrameSaver(max_pending=16, n_workers=1)
+
+            frame = np.zeros((64, 64), dtype=np.uint8)
+            t0 = time.time()
+            for i in range(10):
+                saver.save(frame, os.path.join(tmpdir, f"f{i}.npy"))
+            elapsed = time.time() - t0
+
+            # 非阻塞提交 10 个任务应该很快
+            assert elapsed < 0.5
+
+            saver.flush(timeout=10.0)
+            saver.shutdown()
+
+    def test_creates_subdirectories(self):
+        with tempfile.TemporaryDirectory() as tmpdir:
+            saver = AsyncFrameSaver(max_pending=8, n_workers=1)
+
+            frame = np.zeros((8, 8), dtype=np.uint8)
+            path = os.path.join(tmpdir, "sub1", "sub2", "frame.npy")
+            saver.save(frame, path)
+            saver.flush(timeout=5.0)
+            saver.shutdown()
+
+            assert os.path.exists(path)
+
+
+# ============================================================
+# 5. NumPy 向量化图像处理测试
+# ============================================================
+
+from dac3d.processing.image_ops import (
+    img_max, img_add, img_and, img_thresh,
+    reconstruct_3phase, reconstruct_6phase,
+    is_dark_image, rgb_to_gray,
+)
+
+
+class TestImageOps:
+
+    def test_img_max_no_thresh(self):
+        dest = np.array([10, 20, 30], dtype=np.uint8)
+        src = np.array([15, 10, 50], dtype=np.uint8)
+        img_max(dest, src)
+        np.testing.assert_array_equal(dest, [15, 20, 50])
+
+    def test_img_max_with_thresh(self):
+        dest = np.array([10, 20, 30], dtype=np.uint8)
+        src = np.array([25, 10, 50], dtype=np.uint8)
+        img_max(dest, src, thresh=15)
+        # src_adj = [10, 0, 35], max with dest = [10, 20, 35]
+        np.testing.assert_array_equal(dest, [10, 20, 35])
+
+    def test_img_max_inplace(self):
+        """验证就地操作"""
+        dest = np.zeros((64, 64), dtype=np.uint8)
+        src = np.full((64, 64), 100, dtype=np.uint8)
+        dest_id = id(dest)
+        img_max(dest, src)
+        assert id(dest) == dest_id  # 同一对象
+        assert dest[0, 0] == 100
+
+    def test_img_add(self):
+        dest = np.array([10, 20, 30], dtype=np.uint8)
+        src = np.array([15, 10, 50], dtype=np.uint8)
+        img_add(dest, src)
+        np.testing.assert_array_equal(dest, [15, 20, 50])
+
+    def test_img_and(self):
+        dest = np.array([100, 200, 150], dtype=np.uint8)
+        tmpl = np.array([255, 0, 255], dtype=np.uint8)
+        img_and(dest, tmpl)
+        np.testing.assert_array_equal(dest, [100, 0, 150])
+
+    def test_img_thresh(self):
+        buf = np.array([10, 128, 200, 50], dtype=np.uint8)
+        img_thresh(buf, 100)
+        np.testing.assert_array_equal(buf, [0, 255, 255, 0])
+
+    def test_reconstruct_3phase(self):
+        """测试 3 帧相移重建公式"""
+        h, w = 32, 32
+        merge = np.zeros((h, w), dtype=np.uint8)
+
+        # 模拟 3 帧相移：I1, I2, I3
+        t = np.linspace(0, 2 * np.pi, h * w).reshape(h, w)
+        I1 = (128 + 100 * np.cos(t - 2 * np.pi / 3)).astype(np.uint8)
+        I2 = (128 + 100 * np.cos(t)).astype(np.uint8)
+        I3 = (128 + 100 * np.cos(t + 2 * np.pi / 3)).astype(np.uint8)
+
+        reconstruct_3phase([I1, I2, I3], merge)
+        assert merge.dtype == np.uint8
+        assert merge.max() > 0  # 应该有非零结果
+
+    def test_reconstruct_6phase(self):
+        """测试 6 帧双波长重建"""
+        h, w = 16, 16
+        merge = np.zeros((h, w), dtype=np.uint8)
+
+        imgs = [np.random.randint(50, 200, (h, w), dtype=np.uint8) for _ in range(6)]
+        reconstruct_6phase(imgs, merge)
+        assert merge.dtype == np.uint8
+
+    def test_is_dark_image_dark(self):
+        dark = np.full((64, 64), 10, dtype=np.uint8)
+        assert is_dark_image(dark, threshold=3.0) is True
+
+    def test_is_dark_image_bright(self):
+        bright = np.random.randint(0, 255, (64, 64), dtype=np.uint8)
+        assert is_dark_image(bright, threshold=3.0) is False
+
+    def test_rgb_to_gray(self):
+        # Pure red
+        img = np.zeros((4, 4, 3), dtype=np.uint8)
+        img[:, :, 0] = 255  # R
+        gray = rgb_to_gray(img)
+        assert gray.shape == (4, 4)
+        # 0.299 * 255 ≈ 76
+        assert abs(int(gray[0, 0]) - 76) <= 1
+
+    def test_rgb_to_gray_passthrough(self):
+        """灰度图输入直接返回"""
+        gray = np.full((8, 8), 128, dtype=np.uint8)
+        result = rgb_to_gray(gray)
+        np.testing.assert_array_equal(result, gray)
