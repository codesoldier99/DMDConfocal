+"""
+实时图像预览组件
+
+借鉴 DMDConfocal 的 VideoView 设计：
+- 30ms 定时刷新（~33 FPS）
+- 跳帧策略：仅保留最新帧，不积压
+- 线程安全的帧接收
+"""
+
+import logging
+import threading
+from typing import Optional, Dict, Any
+import numpy as np
+from numpy.typing import NDArray
+
+from dac3d.core.pipeline.render_chain import FrameProcessor
+
+logger = logging.getLogger(__name__)
+
+# 检测 PyQt5 是否可用（测试环境可能没有）
+_HAS_QT = False
+try:
+    from PyQt5.QtWidgets import QWidget, QLabel, QVBoxLayout
+    from PyQt5.QtGui import QImage, QPixmap
+    from PyQt5.QtCore import QTimer, Qt
+    _HAS_QT = True
+except ImportError:
+    pass
+
+
+class LiveViewProcessor(FrameProcessor):
+    """实时图像预览处理器（无 Qt 依赖版）
+
+    可作为 FrameProcessor 插入 RenderChain，接收每一帧数据。
+    使用 30ms 采样策略：只保留最新帧，避免积压。
+    """
+
+    def __init__(self, name: str = "live_view"):
+        self._name = name
+        self._latest_frame: Optional[NDArray] = None
+        self._latest_metadata: Optional[Dict] = None
+        self._lock = threading.Lock()
+        self._frame_count = 0
+        self._dropped_count = 0
+
+    def process(self, frame: NDArray, metadata: Dict[str, Any]) -> None:
+        """接收帧数据（从采集线程调用）
+
+        仅保留最新帧引用，跳过中间帧（等价于 DMDConfocal VideoView 的跳帧策略）
+        """
+        with self._lock:
+            if self._latest_frame is not None:
+                self._dropped_count += 1
+            self._latest_frame = frame.copy()
+            self._latest_metadata = dict(metadata)
+            self._frame_count += 1
+
+    def get_latest(self) -> Optional[tuple]:
+        """获取最新帧（消费后清空）
+
+        Returns:
+            (frame, metadata) 或 None
+        """
+        with self._lock:
+            if self._latest_frame is None:
+                return None
+            frame = self._latest_frame
+            meta = self._latest_metadata
+            self._latest_frame = None
+            self._latest_metadata = None
+            return frame, meta
+
+    @property
+    def frame_count(self) -> int:
+        return self._frame_count
+
+    @property
+    def dropped_count(self) -> int:
+        return self._dropped_count
+
+
+if _HAS_QT:
+    class LiveViewWidget(QWidget, LiveViewProcessor):
+        """实时图像预览 Qt 组件
+
+        借鉴 DMDConfocal VideoView 的定时刷新策略：
+        - SetTimer(529, 30, NULL) → QTimer 30ms
+        - 仅在定时器触发时从最新帧缓冲区取帧显示
+        """
+
+        def __init__(self, parent=None, refresh_ms: int = 30):
+            QWidget.__init__(self, parent)
+            LiveViewProcessor.__init__(self, "live_view_widget")
+
+            self._label = QLabel("No Image")
+            self._label.setAlignment(Qt.AlignCenter)
+            self._label.setMinimumSize(256, 256)
+            self._label.setStyleSheet("background-color: black; color: white;")
+
+            layout = QVBoxLayout(self)
+            layout.setContentsMargins(0, 0, 0, 0)
+            layout.addWidget(self._label)
+
+            # 30ms 定时刷新（等价于 DMDConfocal 的 SetTimer(529, 30, NULL)）
+            self._timer = QTimer()
+            self._timer.timeout.connect(self._refresh)
+            self._timer.start(refresh_ms)
+
+            self._fps_count = 0
+            self._display_count = 0
+
+        def _refresh(self):
+            """定时器回调，在 UI 线程中刷新显示"""
+            result = self.get_latest()
+            if result is None:
+                return
+
+            frame, metadata = result
+            self._display_count += 1
+
+            # uint16 → uint8 映射
+            if frame.dtype == np.uint16:
+                display = (frame >> 8).astype(np.uint8)
+            elif frame.dtype == np.float64 or frame.dtype == np.float32:
+                display = np.clip(frame, 0, 255).astype(np.uint8)
+            else:
+                display = frame.astype(np.uint8)
+
+            # 确保连续内存
+            if not display.flags['C_CONTIGUOUS']:
+                display = np.ascontiguousarray(display)
+
+            h, w = display.shape[:2]
+            if display.ndim == 2:
+                qimg = QImage(display.data, w, h, w, QImage.Format_Grayscale8)
+            else:
+                qimg = QImage(display.data, w, h, w * 3, QImage.Format_RGB888)
+
+            pixmap = QPixmap.fromImage(qimg)
+            scaled = pixmap.scaled(
+                self._label.size(),
+                Qt.KeepAspectRatio,
+                Qt.SmoothTransformation
+            )
+            self._label.setPixmap(scaled)
+
+        @property
+        def display_count(self) -> int:
+            return self._display_count
+
+
+__all__ = ["LiveViewProcessor"]
+if _HAS_QT:
+    __all__.append("LiveViewWidget")
