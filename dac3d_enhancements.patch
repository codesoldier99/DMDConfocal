+"""
+DMD 模拟驱动
+
+参考 DMDConfocal 的 WlpAdapter/AlpAdapter 设计。
+实现 IDMD 接口，支持图案加载、序列播放、触发控制。
+"""
+
+import logging
+import threading
+import time
+from typing import Dict, Any, Optional, List
+import numpy as np
+from numpy.typing import NDArray
+
+from dac3d.hal.interfaces import IDMD, DeviceState, TriggerMode
+
+
+logger = logging.getLogger(__name__)
+
+
+class SimDMD(IDMD):
+    """DMD 模拟器
+
+    模拟 WLP/ALP DMD 设备行为，参考 DMDConfocal 的 WlpAdapter：
+    - 图案以 1-bit 二进制格式存储（节省 8 倍内存）
+    - 支持多种触发模式
+    - 帧序列自动播放
+    """
+
+    def __init__(
+        self,
+        device_id: str = "sim_dmd",
+        config: Optional[Dict[str, Any]] = None,
+    ):
+        super().__init__(device_id, config)
+
+        # DMD 参数
+        self._width = config.get("width", 1024) if config else 1024
+        self._height = config.get("height", 768) if config else 768
+        self._illumination = 1.0
+
+        # 图案存储（二进制压缩，等价于 DMDConfocal 的 pLargeImageBuff）
+        self._patterns: List[NDArray[np.uint8]] = []
+        self._current_index = 0
+        self._frame_count = 0
+
+        # 序列播放
+        self._sequence_running = False
+        self._trigger_mode = TriggerMode.SOFTWARE
+        self._sequence_thread: Optional[threading.Thread] = None
+        self._stop_event = threading.Event()
+
+        # 时序参数（等价于 frame_margin / frame_interval）
+        self._frame_time_ms = config.get("frame_time_ms", 10.0) if config else 10.0
+
+        logger.info(f"SimDMD: {self._width}x{self._height}")
+
+    def connect(self) -> bool:
+        """模拟连接（等价于 WLP_OpenDev）"""
+        logger.info("SimDMD: connecting...")
+        time.sleep(0.05)
+        self._state = DeviceState.CONNECTED
+        logger.info("SimDMD: connected")
+        return True
+
+    def disconnect(self) -> bool:
+        self.stop_sequence()
+        self._state = DeviceState.DISCONNECTED
+        logger.info("SimDMD: disconnected")
+        return True
+
+    def reset(self) -> bool:
+        """复位（等价于 WLP_DevReset + WLP_DMDReset）"""
+        self.stop_sequence()
+        self._patterns.clear()
+        self._current_index = 0
+        self._frame_count = 0
+        self._state = DeviceState.IDLE
+        logger.info("SimDMD: reset")
+        return True
+
+    def get_info(self) -> Dict[str, Any]:
+        return {
+            "device_id": self._device_id,
+            "type": "Simulated DMD",
+            "resolution": f"{self._width}x{self._height}",
+            "n_patterns": len(self._patterns),
+            "current_index": self._current_index,
+            "state": self._state.name,
+        }
+
+    def load_pattern(self, pattern: NDArray[np.uint8]) -> bool:
+        """加载单个图案"""
+        packed = np.packbits(pattern > 127)
+        self._patterns = [packed]
+        self._frame_count = 1
+        logger.debug(f"SimDMD: loaded 1 pattern, packed size={packed.nbytes} bytes")
+        return True
+
+    def load_pattern_sequence(self, patterns: List[NDArray[np.uint8]]) -> bool:
+        """加载图案序列（等价于 DMDConfocal 的批量 DownloadImage）
+
+        图案以 1-bit 二进制格式存储，内存占用为灰度格式的 1/8。
+        """
+        self._patterns = [np.packbits(p > 127) for p in patterns]
+        self._frame_count = len(patterns)
+        logger.info(f"SimDMD: loaded {self._frame_count} patterns")
+        return True
+
+    def display_pattern(self, index: int = 0) -> bool:
+        """显示指定图案"""
+        if 0 <= index < len(self._patterns):
+            self._current_index = index
+            logger.debug(f"SimDMD: displaying pattern {index}")
+            return True
+        logger.error(f"SimDMD: pattern index {index} out of range")
+        return False
+
+    def start_sequence(self, trigger_mode: TriggerMode = TriggerMode.SOFTWARE) -> bool:
+        """启动序列播放（等价于 WLP_Start）"""
+        if not self._patterns:
+            logger.error("SimDMD: no patterns loaded")
+            return False
+
+        self._trigger_mode = trigger_mode
+        self._sequence_running = True
+        self._stop_event.clear()
+        self._current_index = 0
+
+        if trigger_mode in (TriggerMode.CONTINUOUS, TriggerMode.FREERUN):
+            self._sequence_thread = threading.Thread(
+                target=self._sequence_worker, daemon=True
+            )
+            self._sequence_thread.start()
+
+        self._state = DeviceState.BUSY
+        logger.info(f"SimDMD: sequence started, mode={trigger_mode.value}")
+        return True
+
+    def _sequence_worker(self):
+        """序列播放线程（等价于 DMDConfocal 的 TRIGGER_LOOP 模式）"""
+        while not self._stop_event.is_set():
+            self._current_index = (self._current_index + 1) % self._frame_count
+            time.sleep(self._frame_time_ms / 1000.0)
+
+    def stop_sequence(self) -> bool:
+        """停止序列（等价于 WLP_Stop）"""
+        self._sequence_running = False
+        self._stop_event.set()
+        if self._sequence_thread and self._sequence_thread.is_alive():
+            self._sequence_thread.join(timeout=1.0)
+        self._state = DeviceState.IDLE
+        logger.info("SimDMD: sequence stopped")
+        return True
+
+    def set_illumination(self, intensity: float) -> bool:
+        self._illumination = max(0.0, min(1.0, intensity))
+        logger.debug(f"SimDMD: illumination={self._illumination:.2f}")
+        return True
+
+    def get_current_pattern(self) -> Optional[NDArray[np.uint8]]:
+        """获取当前图案（解包为 8-bit，等价于 Binary2Gray）"""
+        if not self._patterns:
+            return None
+        packed = self._patterns[self._current_index]
+        unpacked = np.unpackbits(packed)
+        total_pixels = self._width * self._height
+        if len(unpacked) >= total_pixels:
+            return unpacked[:total_pixels].reshape(self._height, self._width) * 255
+        return None
+
+    @property
+    def width(self) -> int:
+        return self._width
+
+    @property
+    def height(self) -> int:
+        return self._height
+
+    @property
+    def pattern_count(self) -> int:
+        return self._frame_count
+
+
+__all__ = ["SimDMD"]
